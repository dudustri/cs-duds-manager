# Copy to .env only to change a default. Every key is optional; empty means the default shown.
SITE_ADDRESS=http://localhost   # Caddy site address; an http:// prefix means plain HTTP (no TLS)
PUBLIC_IP=                      # ICE host candidate the browser dials; empty = auto (outbound LAN IPv4)
ICE_PORT=27101                  # the single UDP port for every WebRTC session
ROOM_PORTS=27015-27020          # one game port per room; the range size IS the room cap
ROOM_IDLE_TIMEOUT=10m           # stop a room after this long with no humans (min 10s)
ADMIN_PASSWORD_HASH=            # bcrypt, SINGLE-quoted (it contains $); empty disables admin. See README, "Site admin"

# Limits (the defaults suit a public host; tests raise them)
CREATE_LIMIT_BURST=6            # rooms one IP may create at once...
CREATE_LIMIT_EVERY=5m           # ...then one more per this interval
LOGIN_LIMIT_BURST=5             # admin login attempts per IP...
LOGIN_LIMIT_EVERY=12s           # ...then one more per this interval
SESSION_LIMIT_PER_IP=16         # concurrent WebRTC sessions per client IP
SESSION_IDLE_TIMEOUT=60s        # close a session with no upstream datagram for this long
STATUS_EVERY=5s                 # how often each room's status is polled over RCON
READY_TIMEOUT=30s               # how long room creation waits for the server and its mode probe
